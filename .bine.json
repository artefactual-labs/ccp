// See https://github.com/artefactual-labs/bine for config details.
{
    "project": "ccp",
    "bins": [
        {
            "name": "uv",
            "url": "https://github.com/astral-sh/uv",
            "version": "0.8.15",
            "asset_pattern": "{name}-{triple}.tar.gz",
            "tag_pattern": "{version}"
        },
        {
            "name": "buf",
            "url": "https://github.com/bufbuild/buf",
            "version": "1.57.0",
            "asset_pattern": "{name}-{os}-{arch}"
        },
        {
            "name": "go-enum",
            "url": "https://github.com/abice/go-enum",
            "version": "0.9.1",
            "asset_pattern": "{name}_{os}_{arch}"
        },
        {
            "name": "golangci-lint",
            "url": "https://github.com/golangci/golangci-lint",
            "version": "2.4.0",
            "asset_pattern": "{name}-{version}-{goos}-{goarch}.tar.gz"
        },
        {
            "name": "gotestsum",
            "url": "https://github.com/gotestyourself/gotestsum",
            "version": "1.12.3",
            "asset_pattern": "{name}_{version}_{goos}_{goarch}.tar.gz"
        },
        {
            "name": "mockgen",
            "go_package": "go.uber.org/mock/mockgen",
            "version": "0.6.0"
        },
        {
            "name": "sqlc",
            "url": "https://github.com/sqlc-dev/sqlc",
            "version": "1.30.0",
            "asset_pattern": "{name}_{version}_{goos}_{goarch}.tar.gz"
        },
        {
            "name": "tparse",
            "url": "https://github.com/mfridman/tparse",
            "version": "0.18.0",
            "asset_pattern": "{name}_{goos}_{arch}"
        },
        {
            "name": "go-mod-outdated",
            "url": "https://github.com/psampaz/go-mod-outdated",
            "version": "0.9.0",
            "asset_pattern": "{name}_{version}_{os}_{arch}.tar.gz"
        },
        {
            "name": "grpcurl",
            "url": "https://github.com/fullstorydev/grpcurl",
            "version": "1.9.3",
            "asset_pattern": "{name}_{version}_{goos}_{goarch}.tar.gz",
            "modifiers": {
                "goos": {
                    "darwin": "osx"
                },
                "goarch": {
                    "amd64": "x86_64",
                    "386": "x86_62"
                }
            }
        }
    ]
}
